EE_PROJECT=your-google-cloud-project-id

# Optional app-level auth for public mobile HTTPS access. When set, native mobile
# requests must include this token as a Bearer token, x-mobile-api-token header,
# or mobileToken query parameter.
# MOBILE_API_TOKEN=replace-with-a-long-random-token

# Local default uses a small in-process cache. For Google Cloud Memorystore/Redis:
# TILE_CACHE_BACKEND=redis
# REDISHOST=10.0.0.3
# REDISPORT=6379
# Optional full URL override:
# TILE_CACHE_REDIS_URL=redis://10.0.0.3:6379
# TILE_CACHE_TTL_SECONDS=604800
# TILE_CACHE_MEMORY_MAX_BYTES=25165824
# TILE_CACHE_MEMORY_MAX_ENTRIES=240
